# Generated by Cargo
# will have compiled files and executables
debug/
target/
**/target/

# Cargo.lock is tracked. Committing a library's lock does not constrain
# downstream consumers (Cargo ignores it when the crate is used as a
# dependency); it only pins this repo's own build/test/CI graph. That is what we
# audit against, and monocoque also ships a runnable binary (monocoque-rs), so
# the lock is committed and `cargo audit` / `cargo deny` run on the exact
# resolved graph. The per-crate fuzz/loom lockfiles stay ignored below.

# These are backup files generated by rustfmt
**/*.rs.bk
**/*.rs.bk2

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Cargo build artifacts
**/*.rlib
**/*.rmeta
**/*.d
**/*.dll
**/*.dylib
**/*.so
**/*.exe

# Cargo incremental compilation
**/incremental/

# Cargo test artifacts
**/*.profraw
**/*.gcda
**/*.gcno

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Cargo documentation
**/doc/
**/target/doc/

# Cargo registry cache
**/.cargo/registry/
**/.cargo/git/

# Rust analyzer
rust-project.json

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.idea/
*.sublime-workspace
*.sublime-project

# Environment variables
.env
.env.local
.env.*.local

# Benchmark results
criterion/
bench_results/

# Flamegraph profiling
flamegraph.svg
perf.data
perf.data.old

# Python virtual environments
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version
.pytest_cache/

# Fuzzing
monocoque-fuzz/target/

# Excluded-crate lockfiles: monocoque-fuzz and monocoque-loom are outside the
# workspace, so their locks are independent of the tracked workspace Cargo.lock.
# Keep them out of the tree to keep the supply-chain diff to the workspace graph.
monocoque-fuzz/Cargo.lock
monocoque-loom/Cargo.lock
scripts/monocoque_bench_peer/Cargo.lock

# Local agent and tooling runtime artifacts
.claude/
